# ============================================================
#  DJ News Desk — 환경변수
#  이 파일을 .env 로 복사해서 값을 채운다:  cp .env.example .env
#  .env 는 .gitignore 에 있어 절대 커밋되지 않는다.
#  GitHub Actions 에서는 이 파일 대신 저장소 Secrets 를 쓴다.
# ============================================================

# ------------------------------------------------------------
# DART (금융감독원 전자공시) 인증키   ★ 딜 테이블에 필요
# ------------------------------------------------------------
# 무료. 하루 20,000건. 발급 즉시 사용 가능.
# 발급: https://opendart.fss.or.kr → 상단 [인증키 신청/관리] → 회원가입 → 이메일로 40자 키 수신
#
# 상장사의 타법인 주식 취득/양도 결정, 회사합병 결정 공시를 읽어
# M&A 탭의 딜 테이블(투자자·Target·투자금액·지분율)을 채운다.
# 없으면 딜 테이블은 뉴스에서 뽑은 정보만으로 채워지고 빈 칸은 '정보 없음'이 된다.
DART_API_KEY=

# ------------------------------------------------------------
# 네이버 검색 API (현재 미사용)
# ------------------------------------------------------------
# 네이버클라우드 API HUB로 유료 이관되어 쓰지 않는다.
# 나중에 다시 쓸 일이 생기면 아래 두 값을 채우면 자동으로 활성화된다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ------------------------------------------------------------
# 외신 번역 한도 확장 (선택)
# ------------------------------------------------------------
# 외신 제목·요약은 MyMemory 무료 API로 번역한다.
# 키 없이도 하루 5,000단어까지 되지만 그 한도로는 제목까지만 번역한다.
# 이메일을 넣으면 하루 50,000단어로 늘어나 요약까지 번역한다.
# (MyMemory가 사용량을 구분하려고 쓰는 식별자다)
TRANSLATE_EMAIL=
